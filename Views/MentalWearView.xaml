<UserControl x:Class="A_corporate_bureaucratic_application_for_optimizing_managers_and_their_professional_activities.Views.MentalWearView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Image Source="/Assets/MentalTestBGIcon.png"
               Stretch="Fill"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"
               IsHitTestVisible="False"/>

        <TextBlock x:Name="TitleText"
                   Text="SCREENING OF MENTAL ASSET WEAR"
                   FontFamily="{StaticResource MingLiUFont}"
                   FontSize="25"
                   Foreground="Red"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="10,0,0,0"/>

        <Rectangle Height="1"
                   Fill="Red"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Top"
                   Margin="0,33,0,0"/>

        <Grid x:Name="TestPanel">

            <TextBlock x:Name="QuestionText"
                       FontFamily="{StaticResource MingLiUFont}"
                       FontSize="20"
                       Foreground="Black"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Top"
                       Margin="15,38,15,0"/>

            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,105,0,0"
                    Width="200" Height="200"
                    BorderBrush="Black"
                    BorderThickness="1">
                <Image x:Name="QuestionImage"
                       Stretch="Fill"/>
            </Border>

            <StackPanel x:Name="AnswersPanel"
                        Orientation="Vertical"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="30,325,0,0"/>
            
            <Button x:Name="NextButton"
                    Style="{StaticResource ImageButtonStyle}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,20"
                    IsEnabled="False"
                    Click="NextButton_Click">
                <Button.LayoutTransform>
                    <ScaleTransform ScaleX="-1" ScaleY="1"/>
                </Button.LayoutTransform>
                <Image Source="/Assets/ButtonTestIcon.png" Width="200" Height="10" Stretch="Fill"/>
            </Button>
        </Grid>

        <Grid x:Name="ResultPanel" Visibility="Collapsed">
            <TextBlock x:Name="ResultText"
                       FontFamily="{StaticResource MingLiUFont}"
                       FontSize="22"
                       Foreground="Black"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Width="500"/>
        </Grid>
    </Grid>
</UserControl>