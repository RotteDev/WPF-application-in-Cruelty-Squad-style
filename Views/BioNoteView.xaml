<UserControl x:Class="A_corporate_bureaucratic_application_for_optimizing_managers_and_their_professional_activities.Views.BioNoteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Image Source="/Assets/BionoteBG.png"
               Stretch="Fill"
               IsHitTestVisible="False"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"/>

        <TextBlock x:Name="TitleText"
                   Text="BIO NOTE"
                   FontFamily="{StaticResource MingLiUFont}"
                   FontSize="25"
                   Foreground="Red"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="10,0,0,0"/>

        <Rectangle Height="1"
                   Fill="Red"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Top"
                   Margin="0,33,0,0"/>
        <ScrollViewer x:Name="NoteScroll"
              VerticalScrollBarVisibility="Auto"
              HorizontalScrollBarVisibility="Disabled"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              Margin="20,50,20,20">
            <ScrollViewer.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource CrueltyScrollBar}"/>
            </ScrollViewer.Resources>

            <TextBox x:Name="NoteTextBox"
             CharacterCasing="Upper"
             PreviewTextInput="NoteTextBox_PreviewTextInput"
             TextChanged="NoteTextBox_TextChanged"
             FontFamily="{StaticResource GameFont}"
             FontSize="24"
             Foreground="#01D800"
             Background="Black"
             BorderBrush="#01D800"
             BorderThickness="1"
             TextWrapping="Wrap"
             AcceptsReturn="True"
             VerticalScrollBarVisibility="Disabled"
             Padding="10"/>
        </ScrollViewer>

        <Button x:Name="ClearButton"
                Style="{StaticResource ImageButtonStyle}"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,0,40,0"
                Click="ClearButton_Click">
            <Image Source="/Assets/ButtonClearIcon.png" Width="33" Height="33" Stretch="Fill"/>
        </Button>
    </Grid>
</UserControl>