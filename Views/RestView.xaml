<UserControl x:Class="A_corporate_bureaucratic_application_for_optimizing_managers_and_their_professional_activities.Views.RestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#8C8A8C">
        <TextBlock x:Name="TitleText"
                   Text="FATIGUE OPTIMIZATION PROTOCOL"
                   FontFamily="{StaticResource MingLiUFont}"
                   FontSize="25"
                   Foreground="Red"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="10,0,0,0"/>

        <Rectangle Height="1"
                   Fill="Red"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Top"
                   Margin="0,33,0,0"/>

        <TextBox x:Name="RestTextBox"
                 Width="500" Height="38"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 FontFamily="{StaticResource MingLiUFont}"
                 FontSize="30"
                 Foreground="#01D800"
                 Background="Black"
                 BorderBrush="#01D800"
                 BorderThickness="1"
                 TextWrapping="Wrap"
                 TextAlignment="Center"
                 IsReadOnly="True"/>

        <Button x:Name="NextButton"
                Style="{StaticResource ImageButtonStyle}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="0,250,0,0"
                Click="NextButton_Click">
            <Image Source="/Assets/ButtonNextIcon.png" Width="100" Height="80" Stretch="Fill"/>
        </Button>

        <Image x:Name="SmileImage"
               Source="/Assets/Smile0.png"
               Width="150" Height="150"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Margin="0,-250,0,0"
               Stretch="Fill"/>
    </Grid>
</UserControl>