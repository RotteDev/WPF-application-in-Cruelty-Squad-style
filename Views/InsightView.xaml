<UserControl x:Class="A_corporate_bureaucratic_application_for_optimizing_managers_and_their_professional_activities.Views.InsightView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Image Source="/Assets/InsightBG.png"
           Stretch="Fill"
           HorizontalAlignment="Stretch"
           VerticalAlignment="Stretch"
           IsHitTestVisible="False"/>
        
        <TextBlock x:Name="TitleText"
                   Text="CORPORATE INSIGHT"
                   FontFamily="{StaticResource MingLiUFont}"
                   FontSize="25"
                   Foreground="Red"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="10,0,0,0"/>

        <Rectangle Height="1"
                   Fill="Red"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Top"
                   Margin="0,33,0,0"/>

        <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="20,50,0,0" Width="240" Height="60"
                Background="Black" BorderBrush="#01D800" BorderThickness="1">
            <Viewbox Stretch="Uniform">
                <TextBlock x:Name="Box1" FontFamily="{StaticResource MingLiUFont}"
                           Foreground="#01D800" TextWrapping="Wrap"
                           TextAlignment="Center" Margin="2"/>
            </Viewbox>
        </Border>

        <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="280,50,0,0" Width="300" Height="40"
                Background="Black" BorderBrush="#01D800" BorderThickness="1">
            <Viewbox Stretch="Uniform">
                <TextBlock x:Name="Box2" FontFamily="{StaticResource MingLiUFont}"
                           Foreground="#01D800" TextWrapping="Wrap"
                           TextAlignment="Center" Margin="2"/>
            </Viewbox>
        </Border>

        <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="20,120,0,0" Width="380" Height="50"
                Background="Black" BorderBrush="#01D800" BorderThickness="1">
            <Viewbox Stretch="Uniform">
                <TextBlock x:Name="Box3" FontFamily="{StaticResource MingLiUFont}"
                           Foreground="#01D800" TextWrapping="Wrap"
                           TextAlignment="Center" Margin="2"/>
            </Viewbox>
        </Border>

        <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="220,230,0,0" Width="350" Height="25"
                Background="Black" BorderBrush="#01D800" BorderThickness="1">
            <Viewbox Stretch="Uniform">
                <TextBlock x:Name="Box4" FontFamily="{StaticResource MingLiUFont}"
                           Foreground="#01D800" TextWrapping="Wrap"
                           TextAlignment="Center" Margin="2"/>
            </Viewbox>
        </Border>

        <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="20,180,0,0" Width="180" Height="70"
                Background="Black" BorderBrush="#01D800" BorderThickness="1">
            <Viewbox Stretch="Uniform">
                <TextBlock x:Name="Box5" FontFamily="{StaticResource MingLiUFont}"
                           Foreground="#01D800" TextWrapping="Wrap"
                           TextAlignment="Center" Margin="2"/>
            </Viewbox>
        </Border>

        <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="220,180,0,0" Width="260" Height="40"
                Background="Black" BorderBrush="#01D800" BorderThickness="1">
            <Viewbox Stretch="Uniform">
                <TextBlock x:Name="Box6" FontFamily="{StaticResource MingLiUFont}"
                           Foreground="#01D800" TextWrapping="Wrap"
                           TextAlignment="Center" Margin="2"/>
            </Viewbox>
        </Border>

        <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="410,100,0,0" Width="180" Height="70"
                Background="Black" BorderBrush="#01D800" BorderThickness="1">
            <Viewbox Stretch="Uniform">
                <TextBlock x:Name="Box7" FontFamily="{StaticResource MingLiUFont}"
                           Foreground="#01D800" TextWrapping="Wrap"
                           TextAlignment="Center" Margin="2"/>
            </Viewbox>
        </Border>

        <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="20,260,0,0" Width="320" Height="60"
                Background="Black" BorderBrush="#01D800" BorderThickness="1">
            <Viewbox Stretch="Uniform">
                <TextBlock x:Name="Box8" FontFamily="{StaticResource MingLiUFont}"
                           Foreground="#01D800" TextWrapping="Wrap"
                           TextAlignment="Center" Margin="2"/>
            </Viewbox>
        </Border>

        <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="360,260,0,0" Width="220" Height="50"
                Background="Black" BorderBrush="#01D800" BorderThickness="1">
            <Viewbox Stretch="Uniform">
                <TextBlock x:Name="Box9" FontFamily="{StaticResource MingLiUFont}"
                           Foreground="#01D800" TextWrapping="Wrap"
                           TextAlignment="Center" Margin="2"/>
            </Viewbox>
        </Border>

        <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="20,330,0,0" Width="250" Height="80"
                Background="Black" BorderBrush="#01D800" BorderThickness="1">
            <Viewbox Stretch="Uniform">
                <TextBlock x:Name="Box10" FontFamily="{StaticResource MingLiUFont}"
                           Foreground="#01D800" TextWrapping="Wrap"
                           TextAlignment="Center" Margin="2"/>
            </Viewbox>
        </Border>

        <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="290,330,0,0" Width="290" Height="50"
                Background="Black" BorderBrush="#01D800" BorderThickness="1">
            <Viewbox Stretch="Uniform">
                <TextBlock x:Name="Box11" FontFamily="{StaticResource MingLiUFont}"
                           Foreground="#01D800" TextWrapping="Wrap"
                           TextAlignment="Center" Margin="2"/>
            </Viewbox>
        </Border>

        <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="20,420,0,0" Width="560" Height="30"
                Background="Black" BorderBrush="#01D800" BorderThickness="1">
            <Viewbox Stretch="Uniform">
                <TextBlock x:Name="Box12" FontFamily="{StaticResource MingLiUFont}"
                           Foreground="#01D800" TextWrapping="Wrap"
                           TextAlignment="Center" Margin="2"/>
            </Viewbox>
        </Border>

        <Button x:Name="NextButton"
                Style="{StaticResource ImageButtonStyle}"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,10"
                Click="NextButton_Click">
            <Image Source="/Assets/ButtonNextIcon.png" Width="80" Height="60" Stretch="Fill"/>
        </Button>
    </Grid>
</UserControl>