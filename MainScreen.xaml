<Window x:Class="A_corporate_bureaucratic_application_for_optimizing_managers_and_their_professional_activities.MainScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="The session is active"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        Background="Black"
        WindowStartupLocation="CenterScreen"
         Cursor="None"
        Width="1280" Height="720">

    <Window.Resources>
        <FontFamily x:Key="MingLiUFont">pack://application:,,,/Assets/#MingLiU-ExtB</FontFamily>
        <Style x:Key="ImageButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="None"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

            <Setter Property="ToolTipService.InitialShowDelay" Value="0"/>
            <Setter Property="ToolTipService.ShowDuration" Value="5000"/>
            <Setter Property="ToolTipService.BetweenShowDelay" Value="0"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="Black"/>
            <Setter Property="Foreground" Value="#01D800"/>
            <Setter Property="BorderBrush" Value="{x:Null}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="{StaticResource MingLiUFont}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Cursor" Value="None"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Image Source="/Assets/Background1.png"
               Stretch="UniformToFill"
               IsHitTestVisible="False"/>

        <Image x:Name="UIBackground"
       Source="/Assets/UI2.png"
       Stretch="Fill"
       IsHitTestVisible="False"/>

        <Image Source="/Assets/FillerIcon1.png" Stretch="Fill" Margin="148,574,1067,80" IsHitTestVisible="False"/>
        <Image Source="/Assets/FillerIcon2.png" Stretch="Fill" Margin="148,310,1067,344" Width="65" Height="66" IsHitTestVisible="False"/>
        <Image Source="/Assets/FillerIcon4.png" Stretch="Fill" Margin="83,574,1132,80" Width="65" Height="66" IsHitTestVisible="False"/>
        <Image Source="/Assets/FillerIcon1.png" Stretch="Fill" Margin="213,574,1002,80" IsHitTestVisible="False"/>
        <Image Source="/Assets/FillerIcon1.png" Stretch="Fill" Margin="278,574,937,80" IsHitTestVisible="False"/>
        <Image Source="/Assets/FillerIcon3.png" Stretch="Fill" Margin="83,376,1132,278" Width="65" Height="66" IsHitTestVisible="False"/>
        <Image Source="/Assets/FillerIcon4.png" Stretch="Fill" Margin="148,376,1067,278" Width="65" Height="66" IsHitTestVisible="False"/>
        <Image Source="/Assets/FillerIcon2.png" Stretch="Fill" Margin="213,508,1002,146" Width="65" Height="66" IsHitTestVisible="False"/>
        <Image Source="/Assets/FillerIcon1.png" Stretch="Fill" Margin="83,508,1132,146" IsHitTestVisible="False"/>
        <Image Source="/Assets/FillerIcon1.png" Stretch="Fill" Margin="83,442,1132,212" IsHitTestVisible="False"/>
        <Image Source="/Assets/FillerIcon4.png" Stretch="Fill" Margin="213,442,1002,212" Width="65" Height="66" IsHitTestVisible="False"/>
        <Image Source="/Assets/FillerIcon5.png" Stretch="Fill" Margin="278,376,937,278" Height="66" Width="65" IsHitTestVisible="False"/>
        <Image Source="/Assets/FillerIcon5.png" Stretch="Fill" Margin="278,508,937,146" Height="66" Width="65" IsHitTestVisible="False"/>
        <Image Source="/Assets/FillerIcon5.png" Stretch="Fill" Margin="148,442,1067,212" Height="66" Width="65" IsHitTestVisible="False"/>
        <Image Source="/Assets/FillerIcon1.png" Stretch="Fill" Margin="213,310,1002,344" IsHitTestVisible="False" Width="65"/>
        <Image Source="/Assets/FillerIcon1.png" Stretch="Fill" Margin="278,310,937,344" IsHitTestVisible="False" Width="65"/>
        <Image Source="/Assets/FillerIcon1.png" Stretch="Fill" Margin="213,244,1002,410" IsHitTestVisible="False" Width="65"/>
        <Image Source="/Assets/FillerIcon4.png" Stretch="Fill" Margin="83,244,1132,410" Width="65" Height="66" IsHitTestVisible="False"/>
        <Image Source="/Assets/FillerIcon4.png" Stretch="Fill" Margin="278,178,937,476" Width="65" Height="66" IsHitTestVisible="False"/>
        <Image Source="/Assets/FillerIcon2.png" Stretch="Fill" Margin="83,178,1132,476" Width="65" Height="66" IsHitTestVisible="False"/>
        <Image Source="/Assets/FillerIcon3.png" Stretch="Fill" Margin="213,178,1002,476" Width="65" Height="66" IsHitTestVisible="False"/>
        <Image Source="/Assets/FillerIcon2.png" Stretch="Fill" Margin="213,112,1002,542" Width="65" Height="66" IsHitTestVisible="False"/>
        <Image Source="/Assets/FillerIcon4.png" Stretch="Fill" Margin="148,178,1067,476" Width="65" Height="66" IsHitTestVisible="False"/>
        <Image Source="/Assets/FillerIcon3.png" Stretch="Fill" Margin="148,112,1067,542" Width="65" Height="66" IsHitTestVisible="False"/>
        <Image Source="/Assets/FillerIcon5.png" Stretch="Fill" Margin="343,574,872,80" Width="65" Height="66" IsHitTestVisible="False"/>
        <Image Source="/Assets/FillerIcon2.png" Stretch="Fill" Margin="408,574,807,80" Width="65" Height="66" IsHitTestVisible="False"/>
        <Image Source="/Assets/FillerIcon5.png" Stretch="Fill" Margin="408,508,807,146" Width="65" Height="66" IsHitTestVisible="False"/>
        <Image Source="/Assets/FillerIcon2.png" Stretch="Fill" Margin="538,574,677,80" Width="65" Height="66" IsHitTestVisible="False"/>
        <Image Source="/Assets/FillerIcon4.png" Stretch="Fill" Margin="213,442,1002,212" Width="65" Height="66" IsHitTestVisible="False"/>
        <Image Source="/Assets/FillerIcon5.png" Stretch="Fill" Margin="343,442,872,212" Height="66" Width="65" IsHitTestVisible="False"/>

        <Button x:Name="Options" Style="{StaticResource ImageButtonStyle}" ToolTip="Calibration of the senses"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="83,310,0,0">
            <Image Source="/Assets/OptionsIcon.png" Width="65" Height="66" Stretch="Fill"/>
        </Button>

        <Button x:Name="Calculator" Style="{StaticResource ImageButtonStyle}" ToolTip="Debt and depravity calculator"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="213,376,0,0">
            <Image Source="/Assets/DebtandDepravitycalculatorIcon.png" Width="65" Height="66" Stretch="Fill"/>
        </Button>

        <Button x:Name="BioNote" Style="{StaticResource ImageButtonStyle}" ToolTip="Bio note"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="148,508,0,0">
            <Image Source="/Assets/BioNoteIcon.png" Width="65" Height="66" Stretch="Fill"/>
        </Button>

        <Button x:Name="Divine" Style="{StaticResource ImageButtonStyle}" ToolTip="Certification for the divine light index"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="83,112,0,0">
            <Image Source="/Assets/CERTIFICATONFORTHEDIVINELIGHTINDEXIcon.png" Width="65" Height="66" Stretch="Fill"/>
        </Button>

        <Button x:Name="ContactWithCEO" Style="{StaticResource ImageButtonStyle}" ToolTip="Contact with the ceo"
        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="278,244,0,0">
            <Image Source="/Assets/ContactwiththeCEOIcon.png" Width="65" Height="66" Stretch="Fill"/>
        </Button>

        <Button x:Name="CorporateInsight" Style="{StaticResource ImageButtonStyle}" ToolTip="Corporate insight"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="343,508,0,0">
            <Image Source="/Assets/CorporateInsightIcon.png" Width="65" Height="66" Stretch="Fill"/>
        </Button>

        <Button x:Name="FatigueOptimiztionProtocol" Style="{StaticResource ImageButtonStyle}" ToolTip="Fatigue optimization protocol"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="473,574,0,0">
            <Image Source="/Assets/FatigueOptimizationProtocolIcon.png" Width="65" Height="66" Stretch="Fill"/>
        </Button>

        <Button x:Name="HRExecutioner" Style="{StaticResource ImageButtonStyle}" ToolTip="HR EXECUTIONER"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="408,442,0,0">
            <Image Source="/Assets/HRExecutionerIcon.png" Width="65" Height="66" Stretch="Fill"/>
        </Button>

        <Button x:Name="Mental" Style="{StaticResource ImageButtonStyle}" ToolTip="Screening of mental asset wear"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="278,442,0,0">
            <Image Source="/Assets/SCREENINGOFMENTALASSETWEARIcon.png" Width="65" Height="66" Stretch="Fill"/>
        </Button>

        <Button x:Name="Contract" Style="{StaticResource ImageButtonStyle}" ToolTip="The act of indefinite privatization of the subject"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="148,244,0,0">
            <Image Source="/Assets/TheactofindefiniteprivatizationofthesubjectIcon.png" Width="65" Height="66" Stretch="Fill"/>
        </Button>

        <Button x:Name="Exit" Style="{StaticResource ImageButtonStyle}" ToolTip="Exit"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="278,112,0,0">
            <Image Source="/Assets/ExitIcon.png" Width="65" Height="66" Stretch="Fill"/>
        </Button>

        <Button x:Name="DebugTool"
        Style="{StaticResource ImageButtonStyle}"
        ToolTip="Developer tools"
        HorizontalAlignment="Left"
        VerticalAlignment="Top"
        Margin="343,312,0,0"
        Visibility="Collapsed"
        IsHitTestVisible="False">
            <Image Source="/Assets/DebugIcon.png" Width="65" Height="66" Stretch="Fill"/>
        </Button>

        <Border x:Name="ContentPanel"
        Visibility="Collapsed"
        HorizontalAlignment="Left"
        VerticalAlignment="Top"
        Width="600" Height="530"
        Margin="610,110,0,0"
        BorderBrush="Red"
        BorderThickness="1"
        Panel.ZIndex="5000"
        RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform x:Name="ContentPanelScale" ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>
            <Grid>
                <ContentControl x:Name="AppContainer"/>

                <Button x:Name="ClosePanelIcon"
                Style="{StaticResource ImageButtonStyle}"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,0,0,0"
                Click="ClosePanelIcon_Click">
                    <Image Source="/Assets/ClosePanelIcon.png" Width="33" Height="33" Stretch="Fill"/>
                </Button>
            </Grid>
        </Border>
        <Image x:Name="BrainWashImage"
       Width="900" Height="900"
       HorizontalAlignment="Center"
       VerticalAlignment="Center"
       Stretch="Fill"
       IsHitTestVisible="False"
       Panel.ZIndex="10000"
       Visibility="Collapsed"/>

        <Image x:Name="CustomCursor"
       Source="/Assets/Cursor1.png"
       Width="32" Height="32"
       HorizontalAlignment="Left"
       VerticalAlignment="Top"
       IsHitTestVisible="False"
       Panel.ZIndex="999999"/>




        <!-- Self-Kill Notice -->
        <Grid x:Name="SelfKillPanel"
      Background="Black"
      Panel.ZIndex="100000"
      Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="700">
                <TextBlock x:Name="SelfKillText"
                   FontFamily="{StaticResource GameFont}"
                   FontSize="24"
                   Foreground="#01D800"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   Margin="20"
                   Text="DUE TO A SUICIDE ATTEMPT, YOU HAVE BEEN MOVED TO THE STATUS OF POWER IN MISERY. YOUR FLESH IS WORTH NOTHING. DO NOT WORRY, YOU WILL BE HERE FOREVER."/>

                <Button x:Name="UroborosButton"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="0"
                HorizontalAlignment="Center"
                Margin="0,30,0,0"
                Cursor="None"
                Click="UroborosButton_Click">
                    <Image Source="/Assets/UroborosIcon.png"
                   Width="120" Height="120"
                   Stretch="Uniform"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ===== NOTICE PANEL ===== -->
        <!-- СИСТЕМА УВЕДОМЛЕНИЙ -->
        <Grid x:Name="NoticePanel"
      Background="#CC000000"
      Panel.ZIndex="100001"
      Visibility="Collapsed">
            <Border Background="Black"
            BorderBrush="Red"
            BorderThickness="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Width="500" Height="200">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок -->
                    <Border Grid.Row="0" Background="Red">
                        <TextBlock Text="FATAL ERROR"
                           FontFamily="{StaticResource MingLiUFont}"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="Black"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                    </Border>

                    <!-- Текст -->
                    <TextBlock x:Name="NoticeText"
                       Grid.Row="1"
                       FontFamily="{StaticResource GameFont}"
                       FontSize="20"
                       Foreground="#01D800"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="20"/>
                </Grid>
            </Border>
        </Grid>





    </Grid>
</Window>